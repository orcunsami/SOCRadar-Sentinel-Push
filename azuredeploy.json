{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0",
  "parameters": {
    "WorkspaceName": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Sentinel workspace name (not the GUID). A new name is created as part of this deployment when DeployNewWorkspace is true."
      }
    },
    "DeployNewWorkspace": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "true creates the workspace and enables Microsoft Sentinel on it. false uses an existing Microsoft Sentinel workspace in this resource group."
      }
    },
    "WorkspaceLocation": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region of the Microsoft Sentinel workspace. Leave the default unless the workspace is in a different region than this resource group."
      }
    },
    "ServicePrincipalObjectId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Object ID of the Entra application's service principal (Enterprise applications > the app > Object ID). Empty: assign the Monitoring Metrics Publisher role on the data collection rule yourself."
      }
    },
    "TableRetentionDays": {
      "type": "int",
      "defaultValue": 90,
      "minValue": 4,
      "maxValue": 730
    }
  },
  "variables": {
    "location": "[parameters('WorkspaceLocation')]",
    "tableName": "SOCRadar_Alarms_CL",
    "automationRuleId": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName')), 'socradar-ccf-alarm-automation-rule')]",
    "mainTypes": [
      "Executive Protection",
      "Fraud Protection",
      "Vulnerability Monitoring",
      "Deep&Dark Web Monitoring",
      "Internet Asset Inventory Monitoring",
      "Configuration Weakness",
      "Supply Chain Intelligence",
      "Brand Protection",
      "VIP Protection"
    ],
    "ruleTypes": "[concat(variables('mainTypes'), createArray('Other'))]",
    "knownTypesKql": "[replace(replace(string(variables('mainTypes')), '[', '('), ']', ')')]",
    "workbookId": "[guid(resourceGroup().id, parameters('WorkspaceName'), 'socradar-alarms-workbook')]",
    "workbookContent": {
      "version": "Notebook/1.0",
      "items": [
        {
          "type": 1,
          "content": {
            "json": "## SOCRadar alarms\nAlarms the SOCRadar Alarms connector wrote to SOCRadar_Alarms_CL. Only the newest row per alarm counts."
          },
          "name": "title"
        },
        {
          "type": 3,
          "content": {
            "version": "KqlItem/1.0",
            "query": "SOCRadar_Alarms_CL\n| summarize arg_max(TimeGenerated, *) by AlarmId\n| summarize Alarms = count() by Status",
            "size": 1,
            "title": "Alarms by status",
            "timeContext": {
              "durationMs": 2592000000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "visualization": "piechart"
          },
          "name": "by-status"
        },
        {
          "type": 3,
          "content": {
            "version": "KqlItem/1.0",
            "query": "SOCRadar_Alarms_CL\n| summarize arg_max(TimeGenerated, *) by AlarmId\n| summarize Alarms = count() by AlarmMainType\n| sort by Alarms desc",
            "size": 1,
            "title": "Alarms by main type",
            "timeContext": {
              "durationMs": 2592000000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "visualization": "barchart"
          },
          "name": "by-main-type"
        },
        {
          "type": 3,
          "content": {
            "version": "KqlItem/1.0",
            "query": "SOCRadar_Alarms_CL\n| summarize arg_max(TimeGenerated, *) by AlarmId\n| summarize Alarms = count() by Severity",
            "size": 1,
            "title": "Alarms by SOCRadar severity",
            "timeContext": {
              "durationMs": 2592000000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "visualization": "piechart"
          },
          "name": "by-severity"
        },
        {
          "type": 3,
          "content": {
            "version": "KqlItem/1.0",
            "query": "SOCRadar_Alarms_CL\n| summarize arg_max(TimeGenerated, *) by AlarmId\n| summarize Alarms = count() by bin(TimeGenerated, 1d)\n| render timechart",
            "size": 1,
            "title": "New alarms per day",
            "timeContext": {
              "durationMs": 2592000000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          "name": "per-day"
        },
        {
          "type": 3,
          "content": {
            "version": "KqlItem/1.0",
            "query": "SOCRadar_Alarms_CL\n| summarize arg_max(TimeGenerated, *) by AlarmId\n| sort by TimeGenerated desc\n| take 50\n| project TimeGenerated, AlarmId, Title, AlarmMainType, Severity, Status",
            "size": 0,
            "title": "Latest 50 alarms",
            "timeContext": {
              "durationMs": 2592000000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          "name": "latest"
        }
      ],
      "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
    },
    "dceName": "SOCRadar-Push-DCE",
    "dcrName": "SOCRadar-Alarms-Push-DCR"
  },
  "resources": [
    {
      "condition": "[parameters('DeployNewWorkspace')]",
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[parameters('WorkspaceName')]",
      "location": "[variables('location')]",
      "properties": {}
    },
    {
      "condition": "[parameters('DeployNewWorkspace')]",
      "type": "Microsoft.OperationsManagement/solutions",
      "apiVersion": "2015-11-01-preview",
      "name": "[concat('SecurityInsights(', parameters('WorkspaceName'), ')')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]"
      ],
      "plan": {
        "name": "[concat('SecurityInsights(', parameters('WorkspaceName'), ')')]",
        "publisher": "Microsoft",
        "product": "OMSGallery/SecurityInsights",
        "promotionCode": ""
      },
      "properties": {
        "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]"
      }
    },
    {
      "condition": "[parameters('DeployNewWorkspace')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/onboardingStates",
      "apiVersion": "2024-03-01",
      "name": "[concat(parameters('WorkspaceName'), '/Microsoft.SecurityInsights/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationsManagement/solutions', concat('SecurityInsights(', parameters('WorkspaceName'), ')'))]"
      ],
      "properties": {}
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2022-10-01",
      "name": "[concat(parameters('WorkspaceName'), '/', variables('tableName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/providers/onboardingStates', parameters('WorkspaceName'), 'Microsoft.SecurityInsights', 'default')]"
      ],
      "properties": {
        "retentionInDays": "[parameters('TableRetentionDays')]",
        "schema": {
          "name": "[variables('tableName')]",
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "datetime"
            },
            {
              "name": "AlarmId",
              "type": "string"
            },
            {
              "name": "CompanyId",
              "type": "string"
            },
            {
              "name": "AlarmMainType",
              "type": "string"
            },
            {
              "name": "AlarmSubType",
              "type": "string"
            },
            {
              "name": "Severity",
              "type": "string"
            },
            {
              "name": "Status",
              "type": "string"
            },
            {
              "name": "Title",
              "type": "string"
            },
            {
              "name": "AlarmText",
              "type": "string"
            },
            {
              "name": "AlarmDate",
              "type": "string"
            },
            {
              "name": "AlarmPayload",
              "type": "dynamic"
            },
            {
              "name": "EventType",
              "type": "string"
            },
            {
              "name": "CompanyName",
              "type": "string"
            },
            {
              "name": "AlarmAsset",
              "type": "string"
            },
            {
              "name": "AlarmUrl",
              "type": "string"
            },
            {
              "name": "Tags",
              "type": "dynamic"
            },
            {
              "name": "AlarmUpdatedAt",
              "type": "string"
            },
            {
              "name": "ConnectorVersion",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2023-03-11",
      "name": "[variables('dceName')]",
      "location": "[variables('location')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "[variables('dcrName')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('WorkspaceName'), variables('tableName'))]"
      ],
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
        "streamDeclarations": {
          "Custom-SOCRadarAlarmsPush": {
            "columns": [
              {
                "name": "AlarmId",
                "type": "string"
              },
              {
                "name": "CompanyId",
                "type": "string"
              },
              {
                "name": "AlarmMainType",
                "type": "string"
              },
              {
                "name": "AlarmSubType",
                "type": "string"
              },
              {
                "name": "Severity",
                "type": "string"
              },
              {
                "name": "Status",
                "type": "string"
              },
              {
                "name": "Title",
                "type": "string"
              },
              {
                "name": "AlarmText",
                "type": "string"
              },
              {
                "name": "AlarmDate",
                "type": "string"
              },
              {
                "name": "AlarmPayload",
                "type": "dynamic"
              },
              {
                "name": "EventType",
                "type": "string"
              },
              {
                "name": "CompanyName",
                "type": "string"
              },
              {
                "name": "AlarmAsset",
                "type": "string"
              },
              {
                "name": "AlarmUrl",
                "type": "string"
              },
              {
                "name": "Tags",
                "type": "dynamic"
              },
              {
                "name": "AlarmUpdatedAt",
                "type": "string"
              },
              {
                "name": "ConnectorVersion",
                "type": "string"
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
              "name": "clv2ws1"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Custom-SOCRadarAlarmsPush"
            ],
            "destinations": [
              "clv2ws1"
            ],
            "transformKql": "source | extend TimeGenerated = now(), AlarmText = substring(AlarmText, 0, 4000), Severity = toupper(Severity), Status = toupper(Status)",
            "outputStream": "Custom-SOCRadar_Alarms_CL"
          }
        ]
      }
    },
    {
      "condition": "[not(empty(parameters('ServicePrincipalObjectId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, variables('dcrName'), parameters('ServicePrincipalObjectId'))]",
      "scope": "[format('Microsoft.Insights/dataCollectionRules/{0}', variables('dcrName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '3913510d-42f4-4e42-8a64-420c390055eb')]",
        "principalId": "[parameters('ServicePrincipalObjectId')]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2024-03-01",
      "name": "[concat(parameters('WorkspaceName'), '/Microsoft.SecurityInsights/', guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName')), 'socradar-ccf-alarm-rule', variables('ruleTypes')[copyIndex()]))]",
      "kind": "Scheduled",
      "copy": {
        "name": "socradarAlarmRules",
        "count": "[length(variables('ruleTypes'))]",
        "mode": "Serial"
      },
      "properties": {
        "displayName": "[concat('SOCRadar alarm: ', variables('ruleTypes')[copyIndex()])]",
        "description": "[concat('Raises one alert, and one incident, for every OPEN SOCRadar alarm of main type ', variables('ruleTypes')[copyIndex()], '. Switch the rule off to stop incidents for that type.')]",
        "severity": "Medium",
        "enabled": true,
        "query": "[concat('let alerted = SecurityAlert\n| where TimeGenerated > ago(1d)\n| where AlertName startswith \"[SOCRadar] #\"\n| extend AlertAlarmId = tostring(extract(@\"#(\\d+) \", 1, AlertName))\n| distinct AlertAlarmId;\nSOCRadar_Alarms_CL\n| where ingestion_time() > ago(1d)\n| where ingestion_time() < ago(12m)\n| where isnotempty(AlarmId)\n| where column_ifexists(\"EventType\", \"\") != \"connection.test\"\n| where AlarmId !in (alerted)\n| where ', if(equals(variables('ruleTypes')[copyIndex()], 'Other'), concat('AlarmMainType !in ', variables('knownTypesKql')), concat('AlarmMainType == \"', variables('ruleTypes')[copyIndex()], '\"')), '\n| summarize arg_max(TimeGenerated, *) by AlarmId\n| where toupper(Status) == \"OPEN\"\n| extend AlarmUrl = coalesce(column_ifexists(\"AlarmUrl\", \"\"), strcat(\"https://platform.socradar.com/company/\", CompanyId, \"/alarm/\", AlarmId))\n| extend SentinelSeverity = case(toupper(Severity) in (\"CRITICAL\", \"HIGH\"), \"High\", toupper(Severity) == \"MEDIUM\", \"Medium\", \"Low\")\n| extend AlarmDescription = strcat(substring(AlarmText, 0, 1500), \"\\n\\nSOCRadar severity: \", toupper(Severity))\n| project TimeGenerated, AlarmId, CompanyId, Title, AlarmDescription, AlarmMainType, AlarmSubType, Severity, Status, AlarmDate, AlarmUrl, SentinelSeverity\n| order by TimeGenerated asc\n| take 149')]",
        "queryFrequency": "PT10M",
        "queryPeriod": "P1D",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT5M",
        "suppressionEnabled": false,
        "tactics": [],
        "techniques": [],
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "[SOCRadar] #{{AlarmId}} - {{Title}}",
          "alertDescriptionFormat": "{{AlarmDescription}}",
          "alertSeverityColumnName": "SentinelSeverity"
        },
        "customDetails": {
          "AlarmId": "AlarmId",
          "AlarmMainType": "AlarmMainType",
          "AlarmSubType": "AlarmSubType",
          "SocradarSeverity": "Severity",
          "AlarmStatus": "Status"
        },
        "entityMappings": [
          {
            "entityType": "URL",
            "fieldMappings": [
              {
                "identifier": "Url",
                "columnName": "AlarmUrl"
              }
            ]
          }
        ],
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "P7D",
            "matchingMethod": "Selected",
            "groupByEntities": [
              "URL"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('WorkspaceName'), variables('tableName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2024-10-01-preview",
      "name": "[concat(parameters('WorkspaceName'), '/Microsoft.SecurityInsights/', guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName')), variables('ruleTypes')[copyIndex()], 'nrt'))]",
      "kind": "NRT",
      "copy": {
        "name": "socradarAlarmNrtRules",
        "count": "[length(variables('ruleTypes'))]",
        "mode": "Serial"
      },
      "properties": {
        "displayName": "[concat('SOCRadar alarm (NRT): ', variables('ruleTypes')[copyIndex()])]",
        "description": "[concat('Raises an incident within minutes for every new OPEN SOCRadar alarm of main type ', variables('ruleTypes')[copyIndex()], '.')]",
        "severity": "Medium",
        "enabled": true,
        "query": "[concat('SOCRadar_Alarms_CL\n| where isnotempty(AlarmId)\n| where column_ifexists(\"EventType\", \"\") != \"connection.test\"\n| where ', if(equals(variables('ruleTypes')[copyIndex()], 'Other'), concat('AlarmMainType !in ', variables('knownTypesKql')), concat('AlarmMainType == \"', variables('ruleTypes')[copyIndex()], '\"')), '\n| summarize arg_max(TimeGenerated, *) by AlarmId\n| where toupper(Status) == \"OPEN\"\n| extend AlarmUrl = coalesce(column_ifexists(\"AlarmUrl\", \"\"), strcat(\"https://platform.socradar.com/company/\", CompanyId, \"/alarm/\", AlarmId))\n| extend SentinelSeverity = case(toupper(Severity) in (\"CRITICAL\", \"HIGH\"), \"High\", toupper(Severity) == \"MEDIUM\", \"Medium\", \"Low\")\n| extend AlarmDescription = strcat(substring(AlarmText, 0, 1500), \"\\n\\nSOCRadar severity: \", toupper(Severity))\n| project TimeGenerated, AlarmId, CompanyId, Title, AlarmDescription, AlarmMainType, AlarmSubType, Severity, Status, AlarmDate, AlarmUrl, SentinelSeverity')]",
        "suppressionDuration": "PT5M",
        "suppressionEnabled": false,
        "tactics": [],
        "techniques": [],
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "[SOCRadar] #{{AlarmId}} - {{Title}}",
          "alertDescriptionFormat": "{{AlarmDescription}}",
          "alertSeverityColumnName": "SentinelSeverity"
        },
        "customDetails": {
          "AlarmId": "AlarmId",
          "AlarmMainType": "AlarmMainType",
          "AlarmSubType": "AlarmSubType",
          "SocradarSeverity": "Severity",
          "AlarmStatus": "Status"
        },
        "entityMappings": [
          {
            "entityType": "URL",
            "fieldMappings": [
              {
                "identifier": "Url",
                "columnName": "AlarmUrl"
              }
            ]
          }
        ],
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "P7D",
            "matchingMethod": "Selected",
            "groupByEntities": [
              "URL"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('WorkspaceName'), variables('tableName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/automationRules",
      "apiVersion": "2024-03-01",
      "name": "[concat(parameters('WorkspaceName'), '/Microsoft.SecurityInsights/', variables('automationRuleId'))]",
      "dependsOn": [
        "socradarAlarmRules"
      ],
      "properties": {
        "displayName": "SOCRadar - label incidents opened by the alarm rules",
        "order": 1,
        "triggeringLogic": {
          "isEnabled": true,
          "triggersOn": "Incidents",
          "triggersWhen": "Created",
          "conditions": [
            {
              "conditionType": "Property",
              "conditionProperties": {
                "propertyName": "IncidentTitle",
                "operator": "StartsWith",
                "propertyValues": [
                  "[[SOCRadar]"
                ]
              }
            }
          ]
        },
        "actions": [
          {
            "order": 1,
            "actionType": "ModifyProperties",
            "actionConfiguration": {
              "labels": [
                {
                  "labelName": "SOCRadar"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Insights/workbooks",
      "apiVersion": "2021-08-01",
      "name": "[variables('workbookId')]",
      "location": "[variables('location')]",
      "kind": "shared",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('WorkspaceName'), variables('tableName'))]"
      ],
      "properties": {
        "displayName": "SOCRadar Alarms",
        "serializedData": "[string(variables('workbookContent'))]",
        "version": "1.0",
        "category": "sentinel",
        "sourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]"
      }
    }
  ],
  "outputs": {
    "LogIngestionUrl": {
      "type": "string",
      "value": "[concat(reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName')), '2023-03-11').logsIngestion.endpoint, '/dataCollectionRules/', reference(resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName')), '2023-03-11').immutableId, '/streams/Custom-SOCRadarAlarmsPush?api-version=2023-01-01')]"
    },
    "DceUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName')), '2023-03-11').logsIngestion.endpoint]"
    },
    "DcrImmutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName')), '2023-03-11').immutableId]"
    },
    "StreamName": {
      "type": "string",
      "value": "Custom-SOCRadarAlarmsPush"
    },
    "TenantId": {
      "type": "string",
      "value": "[subscription().tenantId]"
    }
  }
}
